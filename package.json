{
  "name": "agendoxa",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:up": "docker compose -f infra/docker-compose.yml --env-file .env up -d --wait postgres",
    "db:test:up": "docker compose -f infra/docker-compose.yml --env-file .env --profile test up -d --wait postgres-test",
    "db:generate": "pnpm --filter @agendoxa/database db:generate",
    "db:check": "pnpm --filter @agendoxa/database db:check",
    "db:migrate": "pnpm --filter @agendoxa/database db:migrate",
    "db:seed": "pnpm --filter @agendoxa/database db:seed",
    "test:db": "pnpm --filter @agendoxa/database test:integration"
  },
  "devDependencies": {
    "turbo": "^2.11.10"
  }
}
