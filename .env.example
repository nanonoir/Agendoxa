# Copiar este archivo a .env y completar con valores locales.
# No commitear .env ni poner credenciales reales en este archivo.

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto de la API (NestJS). La web (Next.js) usa el 3000.
PORT=3001

# Valores públicos de desarrollo local; elegí credenciales propias fuera del entorno local.
POSTGRES_USER=agendoxa
POSTGRES_PASSWORD=agendoxa_local
POSTGRES_DB=agendoxa
POSTGRES_PORT=5432
DATABASE_URL=postgres://agendoxa:agendoxa_local@127.0.0.1:5432/agendoxa

# Servicio de integración separado; nunca usar una base con datos reales.
POSTGRES_TEST_PORT=5433
DATABASE_URL_TEST=postgres://agendoxa_test:agendoxa_test@127.0.0.1:5433/agendoxa_test
